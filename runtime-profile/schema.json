{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/puzzle-survival/runtime-profile.schema.json",
  "title": "Puzzles & Survival runtime profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "profile_id", "profile_version", "profile_content_sha256", "created_at", "runtime", "vm", "graphics", "display", "game", "transport", "startup", "account_guard", "compatibility", "rollback", "evidence"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "profile_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
    "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "profile_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "created_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "runtime": {"$ref": "#/$defs/nonemptyObject"},
    "vm": {"$ref": "#/$defs/nonemptyObject"},
    "graphics": {"$ref": "#/$defs/nonemptyObject"},
    "display": {"$ref": "#/$defs/nonemptyObject"},
    "game": {"$ref": "#/$defs/nonemptyObject"},
    "transport": {"$ref": "#/$defs/nonemptyObject"},
    "startup": {"$ref": "#/$defs/nonemptyObject"},
    "account_guard": {"$ref": "#/$defs/nonemptyObject"},
    "compatibility": {"$ref": "#/$defs/nonemptyObject"},
    "rollback": {"$ref": "#/$defs/nonemptyObject"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "nonemptyObject": {"type": "object", "minProperties": 1}
  }
}
