{
  "schema_version": 2,
  "flow_id": "DAILY-MILESTONE-CLAIM-BLUESTACKS-INTEGRATION",
  "product_purpose": "From canonical Home, open Quest Activity Milestones and claim exactly one current, ready, fully visible, zero-cost milestone chest, prove its same-milestone successor, and return to canonical Home.",
  "trigger_cadence_type": "daily_once",
  "reset_scope": "daily_reset",
  "required_starting_context": ["home_canonical"],
  "shared_primitive_dependencies": [
    {"primitive_id": "home_navigation_primitives", "version_digest_field": "HOME_NAVIGATION_PRIMITIVES_DIGEST", "required": true},
    {"primitive_id": "native_bluestacks_capture_and_session_boundary", "version_digest_field": "BLUESTACKS_NATIVE_RUNTIME_PROFILE_DIGEST", "required": true}
  ],
  "recognized_states": [
    "home_canonical",
    "quest",
    "activity_milestones",
    "milestone_ready",
    "milestone_successor",
    "effect_reconciliation_required",
    "unknown_fail_closed",
    "home_returned",
    "blocked",
    "manual_required"
  ],
  "transition_contracts": [
    {
      "transition_id": "open-quest",
      "from": "home_canonical",
      "to": "quest",
      "planner": "DailyMilestoneClaimNavigation",
      "permitted_input": "open_quest_from_home",
      "postconditions": ["fresh native frame positively recognizes Quest"],
      "terminal_outcomes": ["blocked", "manual_required"]
    },
    {
      "transition_id": "open-activity-milestones",
      "from": "quest",
      "to": "activity_milestones",
      "planner": "DailyMilestoneClaimNavigation",
      "permitted_input": "open_activity_milestones_panel",
      "postconditions": ["fresh native frame positively recognizes Activity Milestones"],
      "terminal_outcomes": ["blocked", "manual_required"]
    },
    {
      "transition_id": "bind-ready-milestone",
      "from": "activity_milestones",
      "to": "milestone_ready",
      "planner": "DailyMilestoneClaimTargetBinding",
      "permitted_input": null,
      "postconditions": [
        "one exact current milestone is bound from the native frame",
        "milestone is ready, fully visible, recognized, and zero-cost",
        "not-ready, already-claimed, clipped, cost-bearing, unknown, contradictory, and stale targets are rejected"
      ],
      "terminal_outcomes": ["deferred", "blocked", "manual_required"]
    },
    {
      "transition_id": "dispatch-milestone",
      "from": "milestone_ready",
      "to": "milestone_successor",
      "planner": "DailyMilestoneClaimActionBoundary",
      "permitted_input": "exactly_one_zero_cost_ready_milestone_chest_claim",
      "postconditions": [
        "exactly one current-frame-bound chest dispatch",
        "dispatch alone is not semantic success",
        "same milestone opened/claimed successor or positive bound points successor is required",
        "an unknown successor requires reconciliation and denies an identical retry"
      ],
      "terminal_outcomes": ["action_performed", "blocked", "manual_required"],
      "evidence_gate_id": "daily_milestone_native_replay"
    },
    {
      "transition_id": "reconcile-unknown-milestone-effect",
      "from": "effect_reconciliation_required",
      "to": "blocked",
      "planner": "fail_closed_without_input",
      "permitted_input": null,
      "postconditions": [
        "no identical milestone claim retry",
        "unresolved effect remains a conductor DONE veto"
      ],
      "terminal_outcomes": ["blocked"]
    },
    {
      "transition_id": "return-canonical-home",
      "from": "milestone_successor",
      "to": "home_returned",
      "planner": "DailyMilestoneClaimRecovery",
      "permitted_input": "return_canonical_home",
      "postconditions": [
        "same milestone successor remains bound before return",
        "canonical Home is positively recognized"
      ],
      "terminal_outcomes": ["complete_for_reset", "blocked", "manual_required"]
    },
    {
      "transition_id": "block-unknown",
      "from": "unknown_fail_closed",
      "to": "blocked",
      "planner": "fail_closed_without_input",
      "permitted_input": null,
      "postconditions": [
        "no milestone transport is dispatched",
        "identical retry is denied"
      ],
      "terminal_outcomes": ["blocked"]
    }
  ],
  "permitted_inputs": [
    "open_quest_from_home",
    "open_activity_milestones_panel",
    "exactly_one_zero_cost_ready_milestone_chest_claim",
    "return_canonical_home"
  ],
  "consequential_action_class": "zero_cost_consequential_milestone_claim",
  "cost_quantity_requirements": {
    "free_only": true,
    "maximum_cost": 0,
    "quantity": 1,
    "resource_or_currency": null,
    "notes": "Only one exact current ready zero-cost milestone chest is permitted."
  },
  "completion_identity": "daily-milestone-claim:one-ready-chest-home-complete",
  "terminal_outcomes": ["action_performed", "deferred", "blocked", "manual_required"],
  "cooldown_deferred_behavior": "A not-ready, already-claimed, absent, or ambiguous milestone permits no dispatch and remains deferred or blocked until a later positively bound observation.",
  "bounded_recovery_behavior": "Unknown or contradictory results fail closed. A dispatch-bearing unknown becomes effect_reconciliation_required, denies identical retry, and vetoes DONE. Return to canonical Home only after the same milestone successor is verified.",
  "product_policy_refs": [
    {"policy_id": "daily-milestone-claim", "source": "tasks/flow_delivery_product_policy.json"},
    {"policy_id": "unknown-consequence", "source": "tasks/flow_delivery_product_policy.json"},
    {"policy_id": "premium-spending", "source": "tasks/flow_delivery_product_policy.json"}
  ],
  "evidence_requirements": [
    "Existing Phase E Bliss and synthetic milestone observations are platform-scoped diagnostic evidence and cannot satisfy current BlueStacks acceptance.",
    "Current native BlueStacks ready-chest, immediate-before, same-milestone opened/claimed or positive bound points successor, and canonical Home evidence remain required.",
    "This product-record migration performs no Milestone Claim input; registration and scheduling remain disabled.",
    "The milestone chest is separate from ordinary row Claim ownership and does not own Daily objective point credit."
  ],
  "evidence_gates": [
