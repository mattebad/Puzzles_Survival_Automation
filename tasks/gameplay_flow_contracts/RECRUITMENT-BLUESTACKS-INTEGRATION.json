{
  "schema_version": 2,
  "flow_id": "RECRUITMENT-BLUESTACKS-INTEGRATION",
  "product_purpose": "Complete the Recruitment Daily objective with five Basic free single recruits in the current reset, one per exact 600-second availability window, then return to canonical Home.",
  "trigger_cadence_type": "cooldown_pulse",
  "reset_scope": "daily_reset",
  "required_starting_context": [
    "home_localized"
  ],
  "shared_primitive_dependencies": [
    {
      "primitive_id": "home_navigation_primitives",
      "version_digest_field": "HOME_NAVIGATION_PRIMITIVES_DIGEST",
      "required": true
    },
    {
      "primitive_id": "noahs_tavern_recruitment_primitives",
      "version_digest_field": "NOAHS_TAVERN_RECRUITMENT_PRIMITIVES_DIGEST",
      "required": true
    }
  ],
  "recognized_states": [
    "home_localized",
    "noahs_tavern",
    "basic_tab_selected",
    "basic_free_available",
    "basic_free_cooldown",
    "basic_free_exhausted",
    "recruit_result",
    "daily_complete",
    "already_complete",
    "deferred",
    "ambiguous_result",
    "home_returned",
    "blocked",
    "manual_required",
    "unknown_fail_closed"
  ],
  "transition_contracts": [
    {
      "transition_id": "recognize_already_complete",
      "from": "home_localized",
      "to": "already_complete",
      "planner": "read_recruitment_daily_reset_ledger",
      "permitted_input": null,
      "postconditions": [
        "five_basic_free_recruits_are_already_confirmed_for_current_reset",
        "terminal_state_is_canonical_home"
      ],
      "terminal_outcomes": [
        "already_complete"
      ]
    },
    {
      "transition_id": "enter_noahs_tavern",
      "from": "home_localized",
      "to": "noahs_tavern",
      "planner": "reuse_noahs_tavern_home_navigation",
      "permitted_input": "open_noahs_tavern",
      "postconditions": [
        "noahs_tavern_screen_recognized_from_fresh_native_frame"
      ],
      "terminal_outcomes": [
        "blocked",
        "manual_required"
      ]
    },
    {
      "transition_id": "select_basic_tab",
      "from": "noahs_tavern",
      "to": "basic_tab_selected",
      "planner": "reuse_noahs_tavern_tier_selector",
      "permitted_input": "select_basic_tab",
      "postconditions": [
        "basic_tab_identity_is_positively_recognized",
        "basic_availability_is_observed"
      ],
      "terminal_outcomes": [
        "blocked"
      ]
    },
    {
      "transition_id": "authorize_basic_free_single",
      "from": "basic_tab_selected",
      "to": "basic_free_available",
      "planner": "reuse_free_recruitment_authorization",
      "permitted_input": null,
      "postconditions": [
        "free_single_control_is_enabled",
        "quantity_is_one",
        "cost_is_zero",
        "paid_premium_item_backed_and_10x_controls_are_excluded",
        "fewer_than_five_basic_recruits_are_confirmed_for_current_reset"
      ],
      "terminal_outcomes": [
        "blocked"
      ]
    },
    {
      "transition_id": "dispatch_one_basic_free_single",
      "from": "basic_free_available",
      "to": "recruit_result",
      "planner": "NoahTavernRecruitRuntimeController.next_command",
      "permitted_input": "exactly_one_basic_free_single",
      "postconditions": [
        "explicit_recruit_result_is_recognized",
        "exactly_one_basic_attempt_is_consumed",
        "no_resource_currency_or_item_is_consumed"
      ],
      "terminal_outcomes": [
        "action_performed",
        "blocked"
      ],
      "evidence_gate_id": "recruitment_daily_production_controller_replay"
    },
    {
      "transition_id": "close_result_and_record_basic_cooldown",
      "from": "recruit_result",
      "to": "basic_free_cooldown",
      "planner": "reuse_safe_result_close_and_postcondition",
      "permitted_input": "close_safe_result_overlay",
      "postconditions": [
        "result_overlay_is_closed_safely",
        "basic_progress_increment_is_persisted",
        "next_basic_eligible_at_uses_exact_600_second_cooldown",
        "daily_claim_is_not_selected"
      ],
      "terminal_outcomes": [
        "action_performed",
        "blocked"
      ]
    },
    {
      "transition_id": "complete_after_fifth_basic",
      "from": "recruit_result",
      "to": "daily_complete",
      "planner": "persist_basic_daily_completion",
      "permitted_input": "close_safe_result_overlay",
      "postconditions": [
        "exactly_five_basic_free_recruits_are_confirmed_for_current_reset",
        "daily_completion_is_owned_by_basic_recruitment_only",
        "daily_claim_is_not_selected"
      ],
      "terminal_outcomes": [
        "complete_for_reset",
        "blocked"
      ]
    },
    {
      "transition_id": "defer_basic_cooldown",
      "from": "basic_free_cooldown",
      "to": "deferred",
      "planner": "yield_with_next_eligible_at",
      "permitted_input": null,
      "postconditions": [
        "next_basic_eligible_at_is_recorded",
        "no_recruitment_input_is_dispatched"
      ],
      "terminal_outcomes": [
        "deferred"
      ]
    },
    {
      "transition_id": "defer_basic_exhausted",
      "from": "basic_free_exhausted",
      "to": "deferred",
      "planner": "record_exhausted_for_reset",
      "permitted_input": null,
      "postconditions": [
        "no_paid_recruit_is_substituted",
        "no_recruitment_input_is_dispatched"
      ],
      "terminal_outcomes": [
        "deferred"
      ]
    },
    {
      "transition_id": "return_home_after_daily_pass",
      "from": "deferred",
      "to": "home_returned",
      "planner": "reuse_recognized_safe_home_return",
      "permitted_input": "safe_return_home",
      "postconditions": [
        "canonical_home_is_positively_recognized"
      ],
      "terminal_outcomes": [
        "deferred",
        "blocked"
      ]
    },
    {
      "transition_id": "return_home_after_daily_completion",
      "from": "daily_complete",
      "to": "home_returned",
      "planner": "reuse_recognized_safe_home_return",
      "permitted_input": "safe_return_home",
      "postconditions": [
        "canonical_home_is_positively_recognized"
      ],
      "terminal_outcomes": [
        "complete_for_reset",
        "blocked"
      ]
    },
    {
      "transition_id": "block_ambiguous_result",
      "from": "ambiguous_result",
      "to": "blocked",
      "planner": "persist_unresolved_without_retry",
      "permitted_input": null,
      "postconditions": [
        "consequential_result_is_recorded_unresolved",
        "identical_recruit_retry_is_prohibited",
        "bounded_safe_home_recovery_is_used_only_from_a_recognized_state"
      ],
      "terminal_outcomes": [
        "blocked"
      ]
    },
    {
      "transition_id": "block_unknown_state",
      "from": "unknown_fail_closed",
      "to": "blocked",
      "planner": "fail_closed_without_input",
      "permitted_input": null,
      "postconditions": [
        "no_transport_is_dispatched"
      ],
      "terminal_outcomes": [
        "blocked"
      ]
    }
  ],
  "permitted_inputs": [
    "open_noahs_tavern",
    "select_basic_tab",
    "exactly_one_basic_free_single",
    "close_safe_result_overlay",
    "safe_return_home"
  ],
  "consequential_action_class": "account_changing_zero_cost_basic_recruitment",
  "cost_quantity_requirements": {
    "free_only": true,
    "maximum_cost": 0,
    "quantity": 5,
    "resource_or_currency": null,
    "notes": "Five Basic free recruits per reset; each consequential transaction is exactly one free single and is separated by the exact 600-second Basic cooldown. Int. and Advanced never own Daily completion."
  },
  "completion_identity": "recruitment:daily-basic-five:complete_for_reset",
  "terminal_outcomes": [
    "action_performed",
    "deferred",
    "complete_for_reset",
    "already_complete",
    "blocked",
    "manual_required"
  ],
  "cooldown_deferred_behavior": "When the next Basic free single is cooling down, persist next_basic_eligible_at from the exact 600-second policy, return deferred without waiting or substituting a paid recruit, and return to canonical Home.",
  "bounded_recovery_behavior": "Close only a positively recognized safe result overlay; ambiguous consequential results are persisted unresolved and never retried identically. Other recovery uses bounded recognized safe exit and must terminate at canonical Home or blocked if Home cannot be proven.",
