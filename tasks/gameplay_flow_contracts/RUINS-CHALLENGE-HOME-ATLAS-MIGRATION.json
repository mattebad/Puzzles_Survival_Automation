{
  "schema_version": 2,
  "flow_id": "RUINS-CHALLENGE-HOME-ATLAS-MIGRATION",
  "product_purpose": "From canonical Home, use a bounded 48-input and 13-action Ruins visit: attempt the current allowlisted zero-cost NPC challenge first, then claim each independently green-ready Stage Overview chest category. A recognized loss may count as participation; challenge unavailability does not suppress ready chest collection.",
  "trigger_cadence_type": "cooldown_pulse",
  "reset_scope": "daily_reset",
  "required_starting_context": [
    "home_canonical"
  ],
  "shared_primitive_dependencies": [
    {
      "primitive_id": "home_navigation_primitives",
      "version_digest_field": "HOME_NAVIGATION_PRIMITIVES_DIGEST",
      "required": true
    }
  ],
  "recognized_states": [
    "home_canonical",
    "ruins_challenge_surface",
    "challenge_available",
    "challenge_unavailable",
    "challenge_result_reconciled",
    "stage_overview",
    "green_ready_category",
    "category_claimed",
    "effect_reconciliation_required",
    "home_returned",
    "blocked",
    "manual_required"
  ],
  "transition_contracts": [
    {
      "transition_id": "open-ruins-challenge",
      "from": "home_canonical",
      "to": "ruins_challenge_surface",
      "planner": "scripts/ruins_challenge_bluestacks.py",
      "permitted_input": "open_ruins_from_current_home_atlas_binding",
      "postconditions": [
        "fresh canonical Home source and current-frame Ruins binding",
        "positively recognized Ruins Challenge surface successor"
      ],
      "terminal_outcomes": [
        "blocked",
        "manual_required"
      ]
    },
    {
      "transition_id": "bind-current-allowlisted-challenge",
      "from": "ruins_challenge_surface",
      "to": "challenge_available",
      "planner": "scripts/ruins_challenge_bluestacks.py",
      "permitted_input": null,
      "postconditions": [
        "current day and exact allowlisted NPC identity are positively bound",
        "zero cost and Attack or Dispatch control are positively recognized"
      ],
      "terminal_outcomes": [
        "action_performed",
        "deferred",
        "blocked",
        "manual_required"
      ]
    },
    {
      "transition_id": "record-current-challenge-unavailable",
      "from": "ruins_challenge_surface",
      "to": "challenge_unavailable",
      "planner": "scripts/ruins_challenge_bluestacks.py",
      "permitted_input": null,
      "postconditions": [
        "challenge is positively recognized unavailable for the current day",
        "no challenge result is fabricated or inferred"
      ],
      "terminal_outcomes": [
        "deferred",
        "blocked"
      ]
    },
    {
      "transition_id": "dispatch-allowlisted-zero-cost-challenge",
      "from": "challenge_available",
      "to": "challenge_result_reconciled",
      "planner": "scripts/ruins_challenge_bluestacks.py",
      "permitted_input": "one_current_allowlisted_zero_cost_attack_or_dispatch",
      "postconditions": [
        "one current-day exact NPC Attack or Dispatch only",
        "positive same-challenge result is recognized; a recognized loss may count as participation",
        "dispatch alone is not success proof"
      ],
      "terminal_outcomes": [
        "action_performed",
        "blocked",
        "manual_required"
      ],
      "evidence_gate_id": "ruins-current-native-acceptance"
    },
    {
      "transition_id": "preserve-unknown-challenge-effect",
      "from": "challenge_available",
      "to": "effect_reconciliation_required",
      "planner": "fail_closed_without_input",
      "permitted_input": null,
      "postconditions": [
        "unknown challenge effect remains unresolved across restart",
        "identical challenge retry is denied"
      ],
      "terminal_outcomes": [
        "blocked",
        "manual_required"
      ],
      "evidence_gate_id": "ruins-current-native-acceptance"
    },
    {
      "transition_id": "open-overview-after-challenge-result",
      "from": "challenge_result_reconciled",
      "to": "stage_overview",
      "planner": "scripts/ruins_challenge_bluestacks.py",
      "permitted_input": "open_stage_overview_after_challenge_or_unavailability",
      "postconditions": [
        "current Stage Overview is positively recognized after the challenge result"
      ],
      "terminal_outcomes": [
        "action_performed",
        "blocked",
        "manual_required"
      ]
    },
    {
      "transition_id": "open-overview-after-unavailable-challenge",
      "from": "challenge_unavailable",
      "to": "stage_overview",
      "planner": "scripts/ruins_challenge_bluestacks.py",
      "permitted_input": "open_stage_overview_after_challenge_or_unavailability",
      "postconditions": [
        "current Stage Overview is positively recognized without inventing a challenge result",
        "independently green-ready chest categories remain eligible"
      ],
      "terminal_outcomes": [
        "action_performed",
        "deferred",
        "blocked",
        "manual_required"
      ]
    },
    {
      "transition_id": "bind-one-green-ready-category",
      "from": "stage_overview",
      "to": "green_ready_category",
      "planner": "scripts/ruins_challenge_bluestacks.py",
      "permitted_input": null,
      "postconditions": [
        "exact chest category is separately observed green and ready on the current overview",
        "non-green or unknown categories are not claimed"
      ],
      "terminal_outcomes": [
        "action_performed",
        "deferred",
        "blocked"
      ]
    },
    {
      "transition_id": "claim-one-green-ready-category",
      "from": "green_ready_category",
      "to": "category_claimed",
      "planner": "scripts/ruins_challenge_bluestacks.py",
      "permitted_input": "claim_one_current_green_ready_stage_category",
      "postconditions": [
        "one exact positively green-ready category claim",
        "positive same-category claim successor is verified and persisted"
      ],
      "terminal_outcomes": [
        "action_performed",
        "blocked",
        "manual_required"
      ],
      "evidence_gate_id": "ruins-current-native-acceptance"
    },
    {
      "transition_id": "preserve-unknown-chest-effect",
      "from": "green_ready_category",
      "to": "effect_reconciliation_required",
      "planner": "fail_closed_without_input",
      "permitted_input": null,
      "postconditions": [
        "unknown effect is persisted for this category and reset",
        "this category's identical claim retry is denied across restart"
      ],
      "terminal_outcomes": [
        "blocked",
        "manual_required"
      ],
      "evidence_gate_id": "ruins-current-native-acceptance"
    },
    {
      "transition_id": "inspect-next-overview-category",
      "from": "category_claimed",
      "to": "stage_overview",
      "planner": "scripts/ruins_challenge_bluestacks.py",
      "permitted_input": null,
      "postconditions": [
        "each remaining category is inspected independently",
        "confirmed categories and unresolved categories remain distinct"
      ],
      "terminal_outcomes": [
        "action_performed",
        "deferred",
        "blocked"
      ]
    },
    {
      "transition_id": "return-home-after-overview",
      "from": "stage_overview",
      "to": "home_returned",
      "planner": "scripts/ruins_challenge_bluestacks.py",
      "permitted_input": "safe_return_to_canonical_home",
      "postconditions": [
        "no independently green-ready unprocessed category remains",
        "canonical Home is positively recognized"
      ],
      "terminal_outcomes": [
        "complete_for_reset",
        "deferred",
        "blocked",
        "manual_required"
      ]
    },
    {
      "transition_id": "return-home-after-unknown-effect",
      "from": "effect_reconciliation_required",
      "to": "home_returned",
      "planner": "scripts/ruins_challenge_bluestacks.py",
      "permitted_input": "safe_return_to_canonical_home",
      "postconditions": [
        "canonical Home is positively recognized without repeating the unresolved challenge or category action"
      ],
      "terminal_outcomes": [
        "blocked",
        "manual_required"
      ]
    }
  ],
  "permitted_inputs": [
    "open_ruins_from_current_home_atlas_binding",
    "one_current_allowlisted_zero_cost_attack_or_dispatch",
    "open_stage_overview_after_challenge_or_unavailability",
    "claim_one_current_green_ready_stage_category",
    "safe_return_to_canonical_home"
  ],
