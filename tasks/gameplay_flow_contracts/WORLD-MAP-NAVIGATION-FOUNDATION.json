      ],
      "notes": "HUD Home-ready start-to-end route only; atlas localization, building binding, and bounded pan/search planning remain offline primitives."
    },
    {
      "scenario_id": "world_navigation_unknown_fail_closed",
      "mode": "blocked_until_evidence",
      "start_state": "unknown_fail_closed",
      "terminal_state": "blocked_fail_closed",
      "permitted_inputs": [],
      "forbidden_inputs": [
        "tap_home_to_world",
