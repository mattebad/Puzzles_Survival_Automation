    {
      "from": "research_lab_visible",
      "to": "research_lab_radial",
      "via": "tap_research_lab"
    },
    {
      "from": "research_lab_radial",
      "to": "nova_lab",
      "via": "tap_nova"
    },
    {
      "from": "nova_lab",
      "to": "praise_attempts_available",
      "via": "open_praise_read_attempts"
    },
    {
      "from": "praise_attempts_available",
      "to": "praise_cooldown",
      "via": "dispatch_one_free_praise"
    },
    {
      "from": "praise_attempts_available",
      "to": "praise_zero_attempts",
      "via": "observe_X_equals_0"
    },
    {
      "from": "praise_cooldown",
      "to": "deferred",
      "via": "yield_with_next_eligible_at"
    },
    {
      "from": "home_localized",
      "to": "home_canonical",
      "via": "ensure_canonical_home",
      "notes": "recovery only when localization/navigation cannot proceed safely"
    }
  ],
  "permitted_inputs": [
    "navigation_only_home_pan",
    "tap_research_lab",
    "tap_nova_radial",
    "open_praise",
    "exactly_one_free_praise_when_authorized"
  ],
  "local_postconditions": [
