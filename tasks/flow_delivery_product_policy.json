  "fail_closed_default": "Unknown cost, target, stage, level, resource, material, or consequence is prohibited.",
  "policies": [
    {
      "policy_id": "campaign-supported-destinations",
      "scope": "campaign.destination",
      "status": "explicitly_approved",
      "decision": "Only 1-20-9, 1-2-9, and ultimate-challenge are supported.",
      "source": "explicit_user_direction"
    },
    {
      "policy_id": "campaign-navigation-validation",
      "scope": "campaign.navigation",
