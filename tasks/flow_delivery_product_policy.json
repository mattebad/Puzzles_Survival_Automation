{
  "schema_version": 1,
  "registry_kind": "flow_delivery_product_policy",
  "purpose": "Record product decisions used by the development-flow queue. This registry does not authorize runtime input by itself.",
  "status_vocabulary": [
    "explicitly_approved",
    "navigation_only_validation",
    "supervised_consequential_validation",
    "unresolved_user_decision",
    "prohibited"
